{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "docker:pinDigests"],
  "timezone": "America/Detroit",
  "gitAuthor": "Jake Robb <jakerobb@users.noreply.github.com>",
  "platformCommit": "disabled",
  "constraints": {
    "npm": "<12"
  },
  "packageRules": [
    {
      "description": "Keep Node on the active LTS line (the Dockerfile and ui/.nvmrc must agree).",
      "matchPackageNames": ["node"],
      "matchDatasources": ["docker"],
      "allowedVersions": "/^24\\./"
    },
    {
      "description": "typescript-eslint doesn't support TypeScript 7 yet; hold the compiler below 6.1 until it does.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1.0"
    },
    {
      "description": "Keep the go directive (which CI's setup-go builds with) on the latest patch release, so govulncheck sees the fixed standard library.",
      "matchDatasources": ["golang-version"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["at any time"]
  }
}
